PORT=3001

# Optional: pings this Telegram chat with a message whenever a new order comes in.
# This is NOT a bot (no commands, no polling) — just one HTTP call to Telegram.
# Leave both blank to disable notifications entirely.
BOT_TOKEN=
ADMIN_ID=

# Payme (paycom.uz) — from the merchant cabinet
PAYME_MERCHANT_ID=your_payme_merchant_id
PAYME_KEY=your_payme_secret_key
PAYME_TEST_MODE=true

# Click (click.uz) — from the merchant cabinet
CLICK_SERVICE_ID=your_click_service_id
CLICK_MERCHANT_ID=your_click_merchant_id
CLICK_MERCHANT_USER_ID=your_click_merchant_user_id
CLICK_SECRET_KEY=your_click_secret_key
